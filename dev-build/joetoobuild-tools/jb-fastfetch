#!/bin/bash

ff_opts=()

# assign arg $1 to determine logo type
LOGO=${1:-"none"}
# use upper case (^^) to select
case "${LOGO^^}" in
    -L|L|--LOGO|LOGO|--LARGE|LARGE) ff_opts=(--logo-type auto) ;;   # this is ff default
    -S|S|--SMALL|SMALL            ) ff_opts=(--logo-type small) ;;
    NONE                          ) ff_opts=(--logo-type none) ;;
    *                             ) echo "Error: invalid LOGO"; exit 1 ;;
esac

# print title with logo
fastfetch "${ff_opts[@]}" -s Title:Separator
# now turn off logo for remaining sections
ff_opts=(--logo-type none)

# to do: add more options here
# ff_opts+=(<more_options>)

ff_platform=()
ff_platform+=(Host Board BIOS Bootmgr TPM)
ff_platform+=(CPU CPUCache GPU PhysicalMemory Memory Swap)

ff_os=()
ff_os+=(OS Kernel InitSystem Packages)

ff_ux=()
ff_ux+=(LM Keyboard Mouse OpenGL Vulkan OpenCL)

ff_storage=()
ff_storage+=(Disk DiskIO)

ff_network=()
ff_network+=(LocalIp DNS Wifi NetIO PublicIp)

ff_user=()
ff_user+=(Locale Shell Editor)
ff_user+=(Terminal TerminalFont TerminalSize TerminalTheme)

ff_state=()
ff_state+=(CPUUsage Loadavg Processes Uptime Users DateTime Weather)


echo '---[ Platform / Hardware ]-------------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_platform[*]}")"

echo '---[ Operating System ]----------------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_os[*]}")"

echo '---[ User Experience / Graphics ]------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_ux[*]}")"

echo '---[ Storage ]-------------------------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_storage[*]}")"

echo '---[ Networking ]----------------------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_network[*]}")"

echo '---[ User Environment ]----------------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_user[*]}")"

echo '---[ Current System State ]-------------'
fastfetch "${ff_opts[@]}" -s "$(IFS=:; echo "${ff_state[*]}")"
