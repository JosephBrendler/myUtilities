# joetoo USE flags for plasma desktop
# To-Do: build 99joetoo_desktop_common to consolidate common settings (from currently-separate 99plasma 99gnome 99lxde 99lxqt)
*/* L10N: -af -am -ar -bg -bn -ca -cs -da -de -el -en-GB -es -es-419 -et -fa -fi -fil -fr -gu -he -hi -hr -hu -id -it -ja -kn -ko -lt -lv -ml -mr -ms -nb -nl -pl -pt-BR -pt-PT -ro -ru -sk -sl -sr -sv -sw -ta -te -th -tr -uk -ur -vi -zh-CN -zh-TW

# xorg
x11-base/xorg-server -suid elogind udev xorg
x11-drivers/xf86-video-intel -uxa -valgrind -xvmc dri sna tools udev
x11-misc/xdotool doc examples

# plasma-meta choices
kde-plasma/plasma-meta bluetooth colord cups discover display-manager elogind gtk kwallet legacy-systray wallpapers
kde-plasma/plasma-meta crypt   #...........# pull in kde plasma vault app
kde-plasma/plasma-meta oxygen-theme   #....# pull in Oxygen icons, sound theme and visual style
kde-plasma/plasma-meta grub   #............# pull in Breeze theme for sys-boot/grub
kde-plasma/plasma-meta sddm   #............# pull in the x11-misc/sddm display manager and system settings module
kde-plasma/plasma-meta smart   #...........# pull in kde-plasma/plasma-disks for disk health
kde-plasma/plasma-meta -networkmanager   #.# (joetoo choice) dont enable net-misc/networkmanager support
kde-plasma/plasma-meta pulseaudio   #......# install Plasma applet for PulseAudio volume management
kde-plasma/plasma-meta X   #...............# enable X window manager support via kde-plasma/kwin-x11 (until ver 6.7)
kde-plasma/plasma-meta xwayland   #........# enable wayland screensharing via gui-apps/xwaylandvideobridge
kde-plasma/plasma-meta browser-integration # enable integration with Chrome/Firefox with browser extensions

# window management and Qt integration
kde-plasma/kwin caps handbook lock multimedia plasma screencast
dev-qt/qtgui X
dev-qt/qtpositioning geoclue
dev-qt/qtwebengine bindist

# kde app profile
kde-apps/kde-apps-meta -games admin education graphics multimedia network utils

# graphics / multimedia
media-libs/mesa opengl vulkan vaapi wayland gbm egl opencl gles2 proprietary-codecs llvm
media-plugins/gst-plugins-meta theora v4l
media-libs/gst-plugins-base theora
media-video/ffmpeg libass

# desktop application integration
net-misc/networkmanager -nss gnutls   # if applicable because user overrides joetoo standard -networkmanager above
net-misc/nextcloud-client dolphin
www-client/chromium bindist

# firefox
www-client/firefox hwaccel -telemetry
media-libs/libvpx postproc

# dropbox
dev-libs/libdbusmenu gtk3
