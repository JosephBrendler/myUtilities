# explicitly opt in on Gentoo's new standard binary package format
BINPKG_FORMAT="gpkg"

# standard FEATURES set for joetoo --
FEATURES=""
FEATURES="${FEATURES} -pid-sandbox"           # off: breaks too many packages
FEATURES="${FEATURES} -usersandbox"           # off: prevent breakage in cross-arch and distcc builds (esp. for SBCs)
FEATURES="${FEATURES} -userpriv"              # off: prevent breakage in cross-arch and distcc builds (esp. for SBCs)
FEATURES="${FEATURES} -collision-protect"     # (obsolete) turn off b/c it breaks binpkg upgrades, multi-slot install
#FEATURES="${FEATURES} -network-sandbox"      # (not needed) turn off: to prevent net-blocking of distcc communication

FEATURES="${FEATURES} sandbox"                # prevents ebuilds from doing stupid things in the production system
FEATURES="${FEATURES} parallel-fetch"         # fetch while building; saves time on slow SBCs
FEATURES="${FEATURES} merge-sync"             # prevents portage from blowing away metadata during sync
FEATURES="${FEATURES} fixlafiles"             # keeps .la files from breaking linking on mixed‑arch systems
#FEATURES="${FEATURES} deterministic"         # reproducible builds across architectures (slows down builds)

FEATURES="${FEATURES} buildpkg"               # build binpkgs for everything (serve to others)
FEATURES="${FEATURES} getbinpkg"              # use external binhost when available
FEATURES="${FEATURES} binpkg-multi-instance"  # required for multi-slot pkgs and gpkg, cluster consistency

#FEATURES="${FEATURES} noman"                 # save space on sbcs
FEATURES="${FEATURES} noinfo"                 # save space on sbcs
FEATURES="${FEATURES} nodoc"                  # save space on sbcs

#FEATURES="${FEATURES} ccache"                # cache compiled results (off until ABI/distcc problems get fixed)
FEATURES="${FEATURES} distcc"                 # participate in distributed compile cluster

# add binpkg signing
FEATURES="${FEATURES} binpkg-signing"         # sign binpkgs
BINPKG_GPG_SIGNING_GPG_HOME="/root/.gnupg"    # joetoo root signing keyring
BINPKG_GPG_SIGNING_KEY="0x292986C3A20A8EF6"   # joetoo root signing keyid
# Override to stabilize HOME=/root/ as environment for binpkg signing
# (force portage binpkg-signing gpg process to use root's canonical/default gnupg context)
# gnupg (invoked by portage) normally starts a keyboxd daemon process with
#   socket /root/.gnupg/S.keyboxd for its /root/.gnupg/public-keys.d/pubring.db database,
#   and portage buildpkg phases normally use a private HOME under /tmp/portage/.../homedir;
# however, if /run/user/0 is available and BINPKG_GPG_SIGNING_BASE_COMMAND is not assigned,
#   then gnupg may select /run/user/0/gnupg/ as the location for a d.<hash>/S.keyboxd socket
#   rather than using /root/.gnupg/ -- starting a second keyboxd daemon
#   which contends with root's existing keyboxd daemon and socket for the same pubring.db.
BINPKG_GPG_SIGNING_BASE_COMMAND="/usr/bin/flock /run/lock/portage-binpkg-gpg.lock"
BINPKG_GPG_SIGNING_BASE_COMMAND="${BINPKG_GPG_SIGNING_BASE_COMMAND} /usr/bin/env HOME=/root"
BINPKG_GPG_SIGNING_BASE_COMMAND="${BINPKG_GPG_SIGNING_BASE_COMMAND} /usr/bin/gpg --sign --armor [PORTAGE_CONFIG]"
# allow sandboxed portage operations to access the signing keyring and the possible root
#   gnupg runtime/socket locations; this is independent of the HOME=/root override above, which
#   stabilizes gnupg's keyboxd socket selection (interface for communication with gnupg daemon processes),
#   explicitly listing root's possible runtime paths (/root/.gnupg and XDG_RUNTIME_DIR now configured
#   in ~/.bash_profile), rather than expanding here the XDG_RUNTIME_DIR variable, which could be empty
SANDBOX_WRITE="/root/.gnupg"
SANDBOX_WRITE="${SANDBOX_WRITE}:/run/user/0"
SANDBOX_WRITE="${SANDBOX_WRITE}:/run/user/0-runtime"
SANDBOX_WRITE="${SANDBOX_WRITE}:/dev/shm/user/0-runtime"

# Maintainer Notes:
# (1) normally, one box might be best to use "userpriv" but this joetoo template is tuned to support
#     a cross-arch distcc cluster, cross-builds for entire systems, binpkgs for multiple arch's,
#     and SBCs with toolchain quirks
# (2) per-package env overrides are available and should also be curated
# (3) precedence: lowest to highest: make.conf, per-package env, command line...
#   *** so app-portage/jus needs to be corrected to NOT override per-package env choices
#       by adding FEATURES= on the command line ***
