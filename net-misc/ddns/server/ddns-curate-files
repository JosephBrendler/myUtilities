#!/bin/bash
#
# ddns-prune-files  -- server side script independent of client ddns updates
#   (executed periodically by cron job to prune dead records)
#   (process only ddns hosts files; openvpn hosts files maintained separately)
#
# run periodically under cron and call ddns-update to remove dead records (to avoid duplicating lock-mgmt code)

PN=${0##*/}

# source /etc/conf.d/ddns if it exists; exit if missing
_conf="/etc/conf.d/ddns"
if [ -f "$_conf" ]; then
    . "$_conf"
else
    logger -p "user.err" -t "${PN}" "(err) Configuration file $_conf missing. Exiting."
    exit 1
fi

# map the sourced config variables to internal script variables if names differ


# BUILD: package build variable generated by the ebuild producing this file
BUILD="${BUILD:-0.0.0}"
# logging tag
TAG="${PN}-${BUILD}" # for log entries
SOURCE="$TAG"        # for ddns-update submission

# dns to query with dig to validate cached address info
joetoo_dns="${JOETOO_DNS_SERVER:-elrond}"

# now sourced from /etc/conf.d/ddns --
LOG_FACILITY="${LOG_FACILITY:-local5}"
DDNS_REVERIFY_INTERVAL="${DDNS_REVERIFY_INTERVAL:-600}"  # seconds (reverify dns if cache info is older than 10 min)
DDNS_CACHE_DIR="${DDNS_CACHE_DIR:-/run/ddns-daemon.cache}"

# assign and apply sensible defaults in case /etc/conf.d/ddns is missing or de-populated
# user: identify the local user who will run ssh (sudo -u $user ssh ...)
user="${DDNS_USER:-joe}"
# ddns_server: identify the alias established in ~/.ssh/config and /etc/ssh/ssh_confg.d/01_joetoo_ssh_config.conf
#   this will be used to set the remote User, shh key id, adn performance/resilience policy options
ddns_server="${DDNS_SSH_ALIAS:-elrond-ddns-46}"
# joetoo_ULA_prefix: first part of local stable SLAAC addresses in joetoo domain
joetoo_ULA_prefix="${JOETOO_ULA_PREFIX:-fd62}"
# joetoo_ip4_prefix: first part of local private ipv4 addresses in joetoo domain
joetoo_ip4_prefix="${JOETOO_IP4_PREFIX:-192.168.6}"
# joetoo_domain: identify the local domain (currently for joetoo this is "brendler")
joetoo_domain="${JOETOO_DOMAIN:-brendler}"

#-----[ Server-specific variables ]-----------------------------------------------------
# LOCK_DIR: path to the lock file used for hosts_file congestion management on sever
LOCK_DIR="${LOCK_DIR:-/run/lock/ddns_updater}"

# IPV4_HOSTS_FILE: hosts file, e.g. --
#   192.168.62.137  gmki91.brendler      # eth0       2026-04-27_02:11:12
ipv4_hosts_file="${IPV4_HOSTS_FILE:-/etc/hosts.d/14_ddns_ipv4}"

# IPV6_HOSTS_FILE: hosts file, e.g. --
#   fd62:6262:6262:0:88ec:ce98:33f8:9d68   gmki91.brendler      # eth0       2026-04-27_13:30:59
ipv6_hosts_file="${IPV6_HOSTS_FILE:-/etc/hosts.d/16_ddns_ipv6}"

# DDNS_PRUNE_THRESHOLD - prune records older than this number of seconds (default: 24 hrs)
DDNS_PRUNE_THRESHOLD="${DDNS_PRUNE_THRESHOLD:-$(( 60 * 60 * 24 ))}"

# DDNS_TIMEOUT - secibds to wait for connectivity check
DDNS_TIMEOUT="${DDNS_TIMEOUT:-2}"

#-----[ openVPN Server-specific variables ]-----------------------------------------------------
# OPENVPN_SERVER_CONFIG_DIR - location of openVPN server.conf file (and disconnect hook script)
OPENVPN_SERVER_CONFIG_DIR="${OPENVPN_SERVER_CONFIG_DIR:-/etc/openvpn/}"

# OPENVPN_PRUNE_THRESHOLD - seconds (default: 2 hrs)
OPENVPN_PRUNE_THRESHOLD="${OPENVPN_PRUNE_THRESHOLD:-$(( 60 * 60 * 2 ))}"

# OPENVPN_STATUS_LOG: where we scrape client info from server's log
OPENVPN_STATUS_LOG="${OPENVPN_STATUS_LOG:-/var/log/openvpn-status.log}"

# OPENVPN_HOSTS_FILE: hosts file, e.g. --
#   192.168.63.22     yorsqui              2026-04-29 19:30:00
#   ------
#   fd62:6262:6263::100e   lcsp6402.brendler         2026-04-29 19:30:01
OPENVPN_HOSTS_FILE="${OPENVPN_HOSTS_FILE:-/etc/hosts.d/20_openVPN_clients}"

# OPENVPN_IPV4_SUBNET: brendler domain subnet for openvpn
OPENVPN_IPV4_SUBNET="${JOETOO_IP4_PREFIX}3"

#-----[ openVPN Client-specific variables ]------------------------------------------------------
# JOETOO_OPENVPNKEYS_DIR - location of client openVPN configs, keys, and hook scripts
JOETOO_OPENVPNKEYS_DIR="${JOETOO_OPENVPNKEYS_DIR:-/etc/openvpn/openvpnkeys_2024/}"


#-----[ variables ]----------------------------------------------------------------
now=$(date +%s)

# use a variable for the tab character to stay POSIX-friendly in awk, sort, printf below
TAB=$'\t'

W0="[[:space:]]*" # regex match for zero or more whitespaces
W1="[[:space:]]+" # regex match for one or more whitespaces
P0="[[:print:]]*" # regex match for zero or more printable characters (incl. whitespace)
P1="[[:print:]]+" # regex match for one or more printable characters (incl. whitespace)
G0="[[:graph:]]*" # regex match for zero or more printable characters (excl. whitespace)
G1="[[:graph:]]+" # regex match for one or more printable characters (excl. whitespace)

# ^^ parameter expansion operator - tells Bash to convert all characters in variable to uppercase
# Route to the appropriate file based on TYPE
#if [ "${TYPE^^}" = "A" ]; then

#-----[ functions ]----------------------------------------------------------------
timestamp() { printf '%s\n' "$(date +'%Y-%m-%d_%H:%M:%S')" ; }

update_or_prune_expired_record() {
    _up_threshold="$1"
    # set ip type
    case "$ip" in *:*) type="AAAA";; *) type="A";; esac
    # check if record is older than threshold
    if (( ( now - ts_date ) > _up_threshold )); then
        msg="(info) line [$line] (is expired)"
        logger -p "${LOG_FACILITY}.info" -t "${TAG}" "${msg}"
        # record is old, so check connectivity and update/delete accordingly
echo "$fqdn record is old"
        if ping -c 1 -W "$DDNS_TIMEOUT" -n "$ip" &>/dev/null; then
            # alive - update
            # format for ddns-update-server call ->
            #  ADDR="$1"; FQDN="$2"; INTERFACE="$3"; TIMESTAMP="$4"; EVENT="$5"(add/del); TYPE="$6"(A/AAAA); SOURCE="${7:-$PN}"
echo "ping yes"
            ddns-update-server "$ip" "$fqdn" "$iface" "$(timestamp)" "add" "$type" "$source"
echo "ip: $ip"
echo "fqdn: $fqdn"
echo "iface: $iface"
echo "ts: $(timestamp)"
echo "add"
echo "type: $type"
echo "source: source"
echo "update result [$?]"
            msg="(debug) updated expired record for active ip [$ip], fqdn [$fqdn]"
            logger -p "${LOG_FACILITY}.debug" -t "${TAG}" "${msg}"
        else
            # delete
echo "ping no"
            ddns-update-server "$ip" "$fqdn" "$iface" "$(timestamp)" "del" "$type" "$source"
echo "delete result [$?]"
            msg="(debug) deleted expired record for absent ip [$ip], fqdn [$fqdn]"
            logger -p "${LOG_FACILITY}.debug" -t "${TAG}" "${msg}"
        fi
    fi

}

#-----[ main script ]----------------------------------------------------------------

# initiate log entry
msg="(info) Pruning DDNS records"
logger -p "${LOG_FACILITY}.info" -t "${TAG}" "${msg}"
msg="(debug) confirming i am who i think i am: who am i|id -u: [$(whoami)|$(id -u)]"
logger -p "${LOG_FACILITY}.debug" -t "${TAG}" "${msg}"

# read and prune each hosts file
for file in "$ipv4_hosts_file" "$ipv6_hosts_file"; do
    msg="(info) Pruning file [$file]"
    logger -p "${LOG_FACILITY}.info" -t "${TAG}" "${msg}"
    # read each file but ignore blank lines and comments
    while read -r line; do
        # ddns hosts file format ->
        # 192.168.63.11 coraldev6401.brendler # tun0 2026-08-09_23:47:09 openvpn-ddns-hook-ipv4.up-0.3.1
        # $1 is ip; ts is between iface and source program ($5) as <date>_<time>
        ip=$(echo $line | awk '{print $1}')
        fqdn=$(echo $line | awk '{print $2}')
        iface=$(echo $line | awk '{print $4}')
        ts=$(echo $line | awk '{print $5}' | sed 's|_| |')
        ts_date=$(date +%s -d "$ts")
        source="${PN}-${BUILD}"
        # call update_or_prune_expired_record to process global variables for DDNS threshold
        update_or_prune_expired_record "$DDNS_PRUNE_THRESHOLD"
    done < <(cat $file | grep -v "^${W0}#" | sed '/^$/d')
done

msg="(notice) Completed."
logger -p "${LOG_FACILITY}.notice" -t "${TAG}" "$msg"
