                                  diag_time_left, has_errors, diag_err_cnt, err_key, parts, type,
                                  ts, ordered_types, n_types ) {
        #printf "%s\n", dubdashline
        printf "  %s[ DIAGNOSTICS ]%s\n", title_clr, clr_off
        #-----[ show active array record counts ]---------------------------------------
