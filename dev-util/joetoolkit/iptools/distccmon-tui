assign_awk_vars() {
    local uav_ret=0
    j_msg -$debug -p "running ${FUNCNAME[0]}"
    # set up a readable array of variables to pass into the awk script
    awk_vars=(
        -v hostname=$(hostname)  #.....................# forward hostname to awk
        -v mode="$mode"  #.............................# tui draw-mode (client, server, both)
        -v verbosity="$verbosity"  #...................# forward to awk from joetoo env
        -v DEBUG=$(TrueFalse $DEBUG)  #................# forward to awk from joetoo env
        -v HISTORY=$(TrueFalse $HISTORY)  #............# whether all of history is ingested for rollup
        -v client_logfile="$tui_client_DISTCC_LOG"  #..# path name of client log file to ingest
        -v server_logfile="$tui_server_DISTCC_LOG"  #..# path name of server log file to ingest
        -v history_depth="$history_depth"  #...........# tui section sizing and timeouts
        -v max_package_lines="$max_package_lines"
        -v max_active_lines="$max_active_lines"
        -v pkg_timeout="$package_timeout"
        -v job_timeout="$job_timeout"
        -v dead_pid_timeout="$dead_pid_timeout"
        -v diagnostic_timeout="$diagnostic_timeout"
        -v diag_msg_type_order="${diag_msg_type_order[*]}"  #..# enable sorted msg order [*] vs [@] to create one space delimited string
        -v width="$tw"  #.........# initialize terminal width (heartbeat updates dynamically)
        -v W0="${W0}"  #..........# W0="[[:space:]]*"     posix zero+ whitespace
        -v W1="${W1}"  #..........# W1="[[:space:]]${W0}" posix one+ whitespace
        -v P0="${P0}"  #..........# P0="[[:print:]]*"     posix zero+ printable
        -v P1="${P1}"  #..........# P1="[[:print:]]${P0}" posix one+ printable
        -v clr="$(CLR)"  #........# clear screen control sequence
        -v cup="$(CUP)"  #........# move cursor control seqquence
        -v line_clr="${BBon}"  #..# tui color profile
        -v data_clr="${BMon}"
        -v ts_clr="${BAon}"
        -v host_clr="${Gon}"
        -v ip_clr="${BTon}"
        -v pkg_clr="${BLon}"
        -v file_clr="${Gon}"
        -v mode_clr="${BYon}"
        -v success_clr="${BGon}"
        -v failure_clr="${BRon}"
        -v title_clr="${BWon}"
        -v heading_clr="${BCon}"
        -v clr_off="${Boff}"
        -v placeholder_clr="${BOon}"
        -v c_file_sel="$c_file_selector"  #.......# selector strings used in grep_filter and awk action block if (...) gates
        -v c_pkg_sel="$c_pkg_selector"
        -v c_host_sel="$c_host_selector"
        -v c_result_sel="$c_result_selector"
        -v c_elapsed_sel="$c_elapsed_selector"
        -v c_exit_sel="$c_exit_selector"
        -v c_child_sel="$c_child_selector"  #.....# use this selector to blacklist spawned child process with only one useless line
        -v s_ip_sel="$s_ip_selector"
