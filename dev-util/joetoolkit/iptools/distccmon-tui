    ### awk function for CLIENT mode ###-------------------------------------------------------------------------------------
    function parse_client_line(    pc_pid, pc_client_id, pc_parts, pc_path, pc_pkg, pc_n, pc_path_parts, pc_final_time, pc_log_str, pc_clean_peer) {
        # if it is a real log line, parse the data
        # and ignore (dcc_increment_safeguard) lines that are spawned child processes that generate only one line
        if ($0 !~ /__HEARTBEAT__/ && $0 !~ c_child_sel) {
            # assign client_id so both client and server modes can use same data structure for active packages
            # (for client mode, it is trivial and by definition)
            pc_client_id = "localhost"
            # extract pid (numeric part of first field; format: "distcc[1234567]"
            match($1, /[0-9]+/)
            pc_pid = substr($1, RSTART, RLENGTH)   # RSTART, RLENGTH are awk built-in tracking regex matched pattern relative to full string
            # guard against a pid declared dead having a follow-on line revive it
            if (pc_pid in c_dead_pids) { return 0 }
            # update last contact for every line received (enable prune if job dies with no exit_sel)
            c_last_contact[pc_pid] = systime()
            # safe default initialization for fields required by piping and logging (do only on first observation of pid)
            if (!(pc_pid in c_active_starts)) {
                c_active_input_files[pc_pid]  = "(null)"
                c_active_peers[pc_pid]        = "localhost"
                c_active_duration[pc_pid]     = "0s"
                c_active_starts[pc_pid]       = systime()

                # DIAGNOSTIC: Log the PID right before deletion to a temp file
#                print systime() " PRE-PROCESS: First observance of PID " pid >> "/tmp/distcc_awk_debug.log"
            }
            # set start placeholder outcome only on the very first encounter (if empty)
            if (!(pc_pid in c_active_outcomes)) {
                c_active_outcomes[pc_pid] = sprintf("%s%-8.8s%s", placeholder_clr, "pending", clr_off) }

            # if line matches selector, save input and output file name and start time for this pid
            #   distcc[646584] "compile from" extensions.c to extensions.c.o
            #   c_file_selector="compile from"  #..............# input_file = $4 ;  output_file = $6
            if ($0 ~ c_file_sel) {
                c_active_input_files[pc_pid] = $4
                c_active_output_files[pc_pid] = $6
            }
            # if line matches selector, save distcc server host_name for this pc_pid
            #   distcc[666568] (dcc_scan_args) found input file "/var/tmp/portage/dev-db/mysql-8.0.45/work/mysql/client/dump/database.cc"
            #   c_pkg_selector="found input file${P1}/work" #...# pkg is extracted from $6/$NF
            if ($0 ~ c_pkg_sel) {
                # for client mode, there is there can be a number of packages - one per ongoing emerge job in different sessions
                # to make the array self-deduplicating, key on the package name itself
                # (should be one package per emerge/make process tho ea session can have many concurrent jobs)
                # this split method is agnostic to which field the package name occupies
                split($0, pc_parts, port_prefix)  # like cut, using port_prefix as delimiter - use parts[2]
                split(pc_parts[2], pc_path, "/")     # like cut, using "/" as delimiter - concat first two fields with another "/"
                pc_pkg = pc_path[2] "/" pc_path[3]      # again like cut, so f1 is left of first / - take f2 f3
                # if pkg and client_id are both assigned, and if c_active_packages is not already assigned, do so
                if (pc_pkg != "" && pc_client_id != "") {
                    # key on client_id (assigned above) and package name to self-deduplicate, and store systime() so we can prune if aged-out
                    if (c_active_packages[pc_client_id][pc_pkg] == "") { c_active_packages[pc_client_id][pc_pkg] = systime() }
                } else {
                    diagnostic_messages["pkg_index_lacking"][systime()] = sprintf( \
                        "(client mode) missing index - client_id: [%s], pkg: [%s]", pc_client_id, pc_pkg)
                }
            }
            # if line matches selector, save distcc server host_name for this pc_pid
            #   distcc[646584] "exec on" gmki92,lzo/4: x86_64-pc-linux-gnu-gcc ...
            #   distcc[646584] "(dcc_lock_host) got cpu lock on" gmki92,lzo/4 slot 0 as fd3 /// <-- alt if not localhost
            #   c_host_selector="\] exec on"  #................#  --> host_name = $4
            if ($0 ~ c_host_sel) {
                c_active_peers[pc_pid] = $4              # like basename split
            }
            # if line matches selector, save outcome for this pc_pid
            #   distcc[646584] "compile" ../accountsservice-23.13.9/src/extensions.c on gmki92,lzo/4 "completed ok"
            #   distcc[2463400] ERROR: compile /var/tmp/portage/dev-db/mysql...SymbolExists.c on nuthuvia,lzo/7 failed
            #   c_result_selector=" compile${P1} on" #.......# outcome = $NF; ok: infile=$3host_name=$5; failed; infile=$4/host_name=$6
            if (($0 ~ c_result_sel) && ($0 !~ / cpp /)) {
                if ($0 ~ /completed ok/) {
                    split($0, pc_parts, " compile ")
                    split(pc_parts[2], pc_path, " on ")
                    pc_n = split(pc_path[1], pc_path_parts, "/")
                    if (!(pc_pid in c_active_input_files)) { c_active_input_files[pc_pid] = pc_path_parts[pc_n] }
                    split($0, pc_parts, " completed ok")
                    pc_n = split(pc_parts[1], pc_line_parts, " ")
                    if (!(pc_pid in c_active_peers)) { c_active_peers[pc_pid] = pc_line_parts[pc_n] }
                    c_active_outcomes[pc_pid] = sprintf("%s%-8.8s%s", success_clr, "success", clr_off)
                } else if ($0 ~ /failed/) {
                    split($0, pc_parts, " compile ")
                    split(pc_parts[2], pc_path, " on ")
                    pc_n = split(pc_path[1], pc_path_parts, "/")
                    if (!(pc_pid in c_active_input_files)) { c_active_input_files[pc_pid] = pc_path_parts[pc_n] }
                    split($0, pc_parts, " failed")
                    pc_n = split(pc_parts[1], pc_line_parts, " ")
                    if (!(pc_pid in c_active_peers)) { c_active_peers[pc_pid] = pc_line_parts[pc_n] }
                    c_active_outcomes[pc_pid] = sprintf("%s%-8.8s%s", failure_clr, "failure", clr_off)
                }
            }
            # if line matches selector, record the elapsed time for this pc_pid
            #   distcc[646584] elapsed compilation time 3.136191s
            #   c_elapsed_selector="elapsed compilation time"  # elapsed = $5 ($NF)
            if ($0 ~ c_elapsed_sel) {
                c_active_duration[pc_pid] = $NF
            }
            # if line matches selector, rotate history and delete active records for this pc_pid
            #   distcc[646584] "(dcc_exit)" exit: code 0; self: 0.008061 user 0.016122 sys; children: 0.270012 user 0.214661 sys
            #   c_exit_selector="(dcc_exit)"  #................# record to history and delete from active records
            if ($0 ~ c_exit_sel) {

                # DIAGNOSTIC: Log the pc_pid right before deletion to a temp file
#                print systime() " PRE-DELETE: exit_sel matched for pc_pid " pc_pid >> "/tmp/distcc_awk_debug.log"

                # use exit code (awk sees "0;" as number 0 in this context) to set c_active_outcomes for this job
                if (($5 + 0) == 0) {
                    c_active_outcomes[pc_pid] = sprintf("%s%-8.8s%s", success_clr, "success", clr_off)
                    # if we have a hostname, then sanitize it for use as a rollup array key
                    if (c_active_peers[pc_pid] != "") {
                        pc_clean_peer = c_active_peers[pc_pid]
                        sub(/,.*/, "", pc_clean_peer)    # strip distcc options (comma and all after, e.g., ,lzo/7, ,cpp)
                        sub(/:$/, "", pc_clean_peer)     # strip trailing colon if present from "exec on" line
                        clientmode_servers_rollup[pc_clean_peer]++
                    }                } else {
                    c_active_outcomes[pc_pid] = sprintf("%s%-8.8s%s", failure_clr, "failure", clr_off)
                }
                pc_final_time = (c_active_duration[pc_pid] != "" ? c_active_duration[pc_pid] : 0)
                pc_log_str = sprintf("[%s%-7.7s%s] [%s%-8.8s%s] %s%-.25s%s on %s%-.25s%s (%s%ds%s) [%s]",
                                  data_clr, pc_pid, clr_off,
                                  ts_clr, strftime("%H:%M:%S"), clr_off,
                                  file_clr, c_active_input_files[pc_pid], clr_off,
                                  host_clr, c_active_peers[pc_pid], clr_off,
                                  ts_clr, pc_final_time, clr_off,
                                  c_active_outcomes[pc_pid])
                rotate_history("client", pc_log_str)
                delete_active_records("client", pc_pid)
                # declare this pc_pid dead now for the routing reason "exit"
                # to ignore any trailing lines that would otherwise re-initialize it
                c_dead_pids[pc_pid] = systime() "|exit"

                # DIAGNOSTIC: verify if the arrays actually cleared
#                if ((!(pc_pid in c_active_starts)) && (!(pc_pid in c_last_contact)) && (!(pc_pid in c_active_peers))) {
#                     print systime() " POST-DELETE SUCCESS: pc_pid " pc_pid " cleared." >> "/tmp/distcc_awk_debug.log"
#                } else {
#                     print systime() " POST-DELETE FAIL: pc_pid " pc_pid " still exists in tracking arrays!" >> "/tmp/distcc_awk_debug.log"
#                }
            }
        }
    }   # end parse_client_line
    ### awk function for SERVER mode ###-------------------------------------------------------------------------------------
    function parse_server_line(    ps_pid, ps_ip, ps_parts, ps_path, ps_client_id,
                                   ps_pkg, ps_log_str, ps_time_str, ps_n, ps_final_time) {
    # Debug: dump every incoming line to stderr to verify the pipe is alive
#     { print "DEBUG [awk server mode input]: " $0 > "/dev/stderr"; fflush("/dev/stderr") }

        # if it is a real log line, parse the data
        # and ignore (dcc_increment_safeguard) lines that are sqawned child processes that generate only one line
        if ($0 !~ /__HEARTBEAT__/ && $0 !~ /dcc_increment_safeguard/) {
            # extract pid (numeric part of first field; format: "distcc[1234567]"
            match($1, /[0-9]+/)
            ps_pid = substr($1, RSTART, RLENGTH)   # RSTART, RLENGTH are awk built-in tracking regex matched pattern relative to full string
            # guard against a pid declared dead having a follow-on line revive it
#            if (ps_pid in s_dead_pids) { return 0 } <-- (NO) server mode: pid persists over several jobs
            # update last contact for every line received (enable prune if job dies with no exit_sel)
            s_last_contact[ps_pid] = systime()
            # safe default initialization for fields required by piping and logging (do only on first observation of pid)
            if (!(ps_pid in s_active_starts)) {
                s_active_input_files[ps_pid]  = "(null)"
                if (!(ps_pid in s_active_peers)) s_active_peers[ps_pid]        = "UNKNOWN_0.0.0.0"  # dont overwrite if done by earlier job in persistent server pid
                if (!(ps_pid in s_active_ip_addrs)) s_active_ip_addrs[ps_pid]     = "0.0.0.0"       # dont overwrite if done by earlier job in persistent server pid
                s_active_duration[ps_pid]     = "0ms"       # "0ms" matching distccd (server) native time unit output format
                s_active_starts[ps_pid]       = systime()
            }
            # set start placeholder outcome only on the very first encounter (if empty)
            if (!(ps_pid in s_active_outcomes)) {
                s_active_outcomes[ps_pid] = sprintf("%s%-8.8s%s", placeholder_clr, "pending", clr_off) }
            # if line matches selector, save input ip address for this pid (assumes it always has a port number to strip
            #   distccd[96193] "(dcc_check_client)" connection from fd62:6262:6262:0:d9ac:eab7:6d40:2331:40662
            #   s_ip_selector="(dcc_check_client)"  #..........#  --> host_ip_address = $NF /// incl port#
            if ($0 ~ s_ip_sel) {
                ps_ip = $NF
                gsub(/:[0-9]+$/, "", ps_ip)             # strip trailing colon and digits (port number)
                s_active_ip_addrs[ps_pid] = ps_ip           # assign to array
                # guard - check if the ip exists in pre-loaded list
                if (ps_ip in dns_cache) {
                    s_active_peers[ps_pid] = dns_cache[ps_ip]
# uncomment to debug
#                    diagnostic_messages["ip_is_in_cache"][systime()] = sprintf("ip address [%s] is in cache with host [%s]", ps_ip, dns_cache[ps_ip])
                } else {
                    # emit signal to shell to trigger call to maybe_get_and_register_hostname
#                    printf "__REGISTER_ME__ %s %s\n", ps_pid, ps_ip
                    s_active_peers[ps_pid] = "UNKNOWN_" ps_ip  # fallback
                    diagnostic_messages["ip_is_in_not_cache"][systime()] = sprintf("(ps_ip) ip address [%s] is NOT in cache", ps_ip)
                }
            }
            # if line matches selector, save input and output file names for this pid (already short form in log)
            #   distccd[96193] "compile from" gtkactions_interface.cpp to gtkactions_interface.cpp.o
            #   s_file_selector="compile from"  #..............# input_file = $4 ;  output_file = $6
            if ($0 ~ s_file_sel) {
                s_active_input_files[ps_pid] = $4
                s_active_output_files[ps_pid] = $6
            }
            # if line matches selector, save distcc server host_name for this pid
            #   1              2                       3                                     4  5         6
            #   distccd[96193] x86_64-pc-linux-gnu-g++ /var/tmp/portage/kde-plasma/.../work  on localhost "completed ok" --> outcome=$NF
            #   s_success_selector="completed ok"  #...........# package = $3 (extractable);  outcome = success
            if ($0 ~ s_success_sel) {
                # for server mode, the list of packages for multiple ip addresses of clients (should be one per)
                # use array of arrays [client_id][pkg] rather than 2-d array (indexing is independent)
                # store systime to know the age of this package record
                # this split method is agnostic to which field the package name occupies
                # but need to ensure port_prefix is found, else test-compile lines that dont have it will assign " / " as pkg
                if (split($0, ps_parts, port_prefix) > 1) {  # like cut, using port_prefix as delimiter - use parts[2]
                    split(ps_parts[2], ps_path, "/")            # like cut, using "/" as delimiter - concat first two fields with another "/"
                    ps_pkg = ps_path[2] "/" ps_path[3]             # again like cut, so f1 is left of first / - take f2 f3
                } else {
                    ps_pkg = ""                              # assign null pkg to preclude s_active_packages assignment below
                }
                # server-mode client_id is ip of client
                ps_client_id = s_active_ip_addrs[ps_pid]
                # if pkg and client_id are both assigned, and if s_active_packages is not already assigned, do so
                if (ps_pkg != "" && ps_client_id != "" && ps_client_id != "0.0.0.0") {
                    # key on client_id (assigned above) and package name to self-deduplicate, and store systime() so we can prune if aged-out
                    if (s_active_packages[ps_client_id][ps_pkg] == "") { s_active_packages[ps_client_id][ps_pkg] = systime() }
                 # removed else block with diagnostic because, in the dcc_job_summary, messages NOT including a portage prefixed path
                 # are almosts certainly just "test compile" cases running for the ebuild and not actual files being compiled for pkg
#                } else {
#                    diagnostic_messages["pkg_index_lacking"][systime()] = sprintf( \
#                        "(success block) array index missing or default - client_id: [%s], pkg: [%s]", client_id, pkg)
                }
                # dont need to annotate history section for success until summary is processed, but do annotate outcome in active section for a blink
                s_active_outcomes[ps_pid] = sprintf("%s%-8.8s%s", success_clr, $NF, clr_off)
            }
            # if line matches selector, record the outcome for this pid
            #   distccd[1460350] (dcc_readx) ERROR: unexpected eof on fd5
            #   s_failure_selector="ERROR:"  #.................# && /dcc_r/ --> outcome = all after ERROR:
            if (($0 ~ s_failure_sel) && ($0 ~ /dcc_r/)) {
                split($0, ps_parts, "ERROR: ")
                s_active_outcomes[ps_pid] = sprintf("%s%-8.8s%s", failure_clr, ps_parts[2], clr_off)
                if (!(ps_pid in s_active_duration)) { s_active_duration[ps_pid] = systime() - s_active_starts[ps_pid] }
                ps_final_time = (s_active_duration[ps_pid] != "" ? s_active_duration[ps_pid] : "0ms")
                ps_log_str = sprintf("[%s%-7.7s%s] [%s%-8.8s%s] %s%-.25s%s on %s%-.25s%s (%s%ds%s) [%s]",
                                  data_clr, ps_pid, clr_off,
                                  ts_clr, strftime("%H:%M:%S"), clr_off,
                                  file_clr, s_active_input_files[ps_pid], clr_off,
                                  host_clr, s_active_peers[ps_pid], clr_off,
                                  ts_clr, ps_final_time, clr_off,
                                  s_active_outcomes[ps_pid])
                # update history with record of failure, but and delete active records
                # (which still protects ip and hostname but cleans out filenames, etc)
                rotate_history("server", ps_log_str)
                delete_active_records("server", ps_pid)
            }
            # if line matches selector, record the elapsed time for this pid
            #   distccd[96193] (dcc_job_summary) client: fd62:6262:6262:0:d9ac:eab7:6d40:2331:40662 COMPILE_OK exit:0 \
            #                ... sig:0 core:0 ret:0 time:21251ms x86_64-pc-linux-gnu-g++  \
            #                ... /var/tmp/portage/kde-plasma/plasma-workspace-6.6.5-r1/work/plasma-workspace-6.6.5_build/gmenu-dbusmenu-proxy/gtkactions_interface.cpp
            #   s_summary_selector="(dcc_job_summary)"  #......# elapsed = $10; exit_code = $6 (set outcome)
            #                                           #......# package = $12 (extract); infile = $12 (basename)
            #                                           #......# also record to history and delete from active records
            if ($0 ~ s_summary_sel) {
                # assess success/falure - note both get exit: 0 status, so use COMPILE_OK vs OTHER in $5
                if ($5 == "COMPILE_OK") {
                    s_active_outcomes[ps_pid] = sprintf("%s%-8.8s%s", success_clr, "success", clr_off)
                } else {
                    s_active_outcomes[ps_pid] = sprintf("%s%-8.8s%s", failure_clr, "failure", clr_off)
                }
                # if ip or host_name is empty, try to fill it
                if (s_active_ip_addrs[ps_pid] =="" || s_active_ip_addrs[ps_pid] == "0.0.0.0") {
                    ps_ip = $4
                    gsub(/:[0-9]+$/, "", ps_ip)             # strip trailing colon and digits (port number)
                    s_active_ip_addrs[ps_pid] = ps_ip           # assign to array
                    # guard - check if the ip exists in pre-loaded list
                    if (ps_ip in dns_cache) {
                        s_active_peers[ps_pid] = dns_cache[ps_ip]
                    } else {
                        # emit signal to shell to trigger call to maybe_get_and_register_hostname
#                        printf "__REGISTER_ME__ %s %s\n", pid, ip
                        s_active_peers[ps_pid] = "UNKNOWN_" ps_ip  # fallback
                        diagnostic_messages["ip_is_in_not_cache"][systime()] = sprintf("(ps_summary) ip address [%s] is NOT in cache", ps_ip)
                    }
                }
                # if job is complete and we have a ip address, increment the server mode rollup
                if ($5 == "COMPILE_OK" && s_active_ip_addrs[ps_pid] != "") {
                    servermode_clients_rollup[s_active_ip_addrs[ps_pid]]++
                }                # if package is empty, try to fill it
                # this split method is agnostic to which field the package name occupies
                # but need to ensure port_prefix is found, else test-compile lines that dont have it will assign " / " as pkg
                if (split($0, ps_parts, port_prefix) > 1) {  # like cut, using port_prefix as delimiter - use parts[2]
                    ps_n = split(ps_parts[2], ps_path, "/")        # like cut, using "/" as delimiter - concat first two fields with another "/"
                    ps_pkg = ps_path[2] "/" ps_path[3]             # again like cut, so f1 is left of first / - take f2 f3
                } else {
                    ps_pkg = ""                                    # assign null pkg to preclude s_active_packages assignment below
                }
                # server-mode client_id is ip of client
                ps_client_id = s_active_ip_addrs[ps_pid]
                # if pkg and client_id are both assigned, and if s_active_packages is not already assigned, do so
                if (ps_pkg != "" && ps_client_id != "" && ps_client_id != "0.0.0.0") {
                    # key on client_id (assigned above) and package name to self-deduplicate, and store systime() so we can prune if aged-out
                    if (s_active_packages[ps_client_id][ps_pkg] == "") { s_active_packages[ps_client_id][ps_pkg] = systime() }
                 # removed else block with diagnostic because, in the dcc_job_summary, messages NOT including a portage prefixed path
                 # are almosts certainly just "test compile" cases running for the ebuild and not actual files being compiled for pkg
#                } else {
#                    diagnostic_messages["pkg_index_lacking"][systime()] = sprintf( \
#                        "(summary block) array index missing or default - client_id: [%s], pkg: [%s]", ps_client_id, ps_pkg)
                }
                # if infile is still empty, but pkg is assigned, fill infile with last element of path
                if (!(ps_pid in s_active_input_files)) {s_active_input_files[ps_pid] = ps_path[ps_n] }
                # record elapsed time
                split($0, ps_parts, "time:")    #...# format: " ... time:21576ms ..." cut from line using "time:" as delimiter
                split(ps_parts[2], ps_time_str, " ")   # cut from remaining line using " " as delimiter
                s_active_duration[ps_pid] = ps_time_str[1]
                ps_final_time = (s_active_duration[ps_pid] != "" ? s_active_duration[ps_pid] : "0ms")
                ps_log_str = sprintf("[%s%-7.7s%s] [%s%-8.8s%s] %s%-.25s%s on %s%-.25s%s (%s%ds%s) [%s]",
                                  data_clr, ps_pid, clr_off,
                                  ts_clr, strftime("%H:%M:%S"), clr_off,
                                  file_clr, s_active_input_files[ps_pid], clr_off,
                                  host_clr, s_active_peers[ps_pid], clr_off,
                                  ts_clr, ps_final_time, clr_off,
                                  s_active_outcomes[ps_pid])
                rotate_history("server", ps_log_str)
                delete_active_records("server", ps_pid)
                # do NOT declare this pid dead now - pid persists in server mode as long as the compiler slot stays open
                # likely for the duration of the package.  We actually NEED trailing lines (for new jobs under this pid)
                # to re-initialize the active records associated with pid and get new filename, etc.
            }
        }
    }   # end parse_server_line
    #-----[ main block of awk script ]-------------------------------------------------------------------------
    {
        # Debug: dump every incoming line to stderr to verify the pipe is alive
#        { print "DEBUG [dns cache input]: " $0 > "/dev/stderr"; fflush("/dev/stderr") }
        # structure is four logically orthogonal blocks for three kinds of
        # streaming data uniquely identified by the beginning of each line
        # __DNS_UPDATE__ and __HEARTBEAT__ come from the parent bash shell itself
        # distcc[ and distccd[ come from log data tailed to awk by the parent bash shell
        if (match($0, "^__DNS_UPDATE__" W1)) {
            # bash is injecting a dns update (or initialization) for the dns_cache; consume it
            # dont trust the field sepation enumeration $2, $3, etc...
            # strip the tag and following whitespace (W1 is posix one+ whitespace) - leaving ip first in remainder
            # extract everything after the tag and its spaces
            payload = substr($0, RSTART + RLENGTH)
            split(payload, data_parts)
            ip = data_parts[1]
            host = data_parts[2]
            dns_cache[ip] = host
            # check ingested values and log diagnostic report (for debugging)
            if (ip != "") {
                diagnostic_messages["dns_ip_diagnostic"][systime()] = sprintf( \
                    "Ingested ip: [%s] from line [%s]", ip, $0 )
            } else {
                diagnostic_messages["dns_ip_diagnostic"][systime()] = sprintf( \
                    "Failed to ingest ip from line [%s]", $0 )
            }
            # check ingested values and log diagnostic report (for debugging)
            if (host != "") {
                diagnostic_messages["dns_host_diagnostic"][systime()] = sprintf( \
                     "Ingested host: [%s] from line [%s]", host, $0 )
            } else {
                diagnostic_messages["dns_host_diagnostic"][systime()] = sprintf( \
                      "Failed to ingest host from line [%s]", $0 )
            }
            # check ingested values and log diagnostic report (for debugging)
            if (ip in dns_cache) {
                diagnostic_messages["dns_cache_diagnostic"][systime()] = sprintf( \
                    "Ingested dns_cache[%s] content: [%s] from line [%s]", ip, dns_cache[ip], $0 )
            } else {
                diagnostic_messages["dns_cache_diagnostic"][systime()] = sprintf( \
                    "Failed to ingest dns_cache[%s] content from line [%s]", ip, $0 )
            }
        } else if ($0 ~ /^__CONTROL__/) {
            # debug - uncomment to dump all control lines
            diagnostic_messages["control_line"][systime()] = "(debug) control line [" $0 "]"
            # backgrounded tui_controller listens for these keys and writes cmd >&4
            #     '+' - "VERBOSITY_UP\n"
            #     '-' - "VERBOSITY_DOWN\n"
            # 'D'|'V' - "TOGGLE_DEBUG\n"
            #     'c' - "CLIENT_MODE\n"
            #     's' - "SERVER_MODE\n"
            #     'b' - "BOTH_MODE\n"
            #     'q' - "QUIT\n" >&4
            # control/heartbeat loop of stream_log_data does this:
            #     _cmd="$(cat "$_ctrl_file")"
            #     printf "__CONTROL__ %s\n" "$_cmd"
            cmd = $2
            if (cmd == "VERBOSITY_UP") {
                if (verbosity < 7) verbosity++  # clamp to 7 = debug
            } else if (cmd == "VERBOSITY_DOWN") {
                if (verbosity >0) verbosity--   # clamp to 0 = emerg
            } else if (cmd == "TOGGLE_DEBUG") {
                if (DEBUG == "True") { DEBUG = "False" } else { DEBUG = "True" }
            } else if (cmd == "CLIENT_MODE") {
                mode = "client"
            } else if (cmd == "SERVER_MODE") {
                mode = "server"
            } else if (cmd == "BOTH_MODE") {
                mode = "both"
            } else if (cmd == "QUIT") {
                # this is really just a visual placeholder, the backgrounded launch_tui_controller kills $$ directly
                printf "__KILL_ME__\n"
                exit 0
            } else {
                diagnostic_messages["bad_control"][systime()] = "unexpected or malformatted control line [" $0 "]"
            }
        } else if ($0 ~ /^__HEARTBEAT__/) {
            # heartbeat carries field(s) that enable dynamic interaction with awk
            # e.g. update terminal width dynamically
            width = $2
            # update ui assets using dynamic width
            dashline = sprintf("%s%s%s", line_clr, repeat("-", width), clr_off)
            dubdashline = sprintf("%s%s%s", line_clr, repeat("=", width), clr_off)
            topline = sprintf("%s%s%s", mode_clr, repeat("_", width), clr_off)
            separator = sprintf("%s%s%s", line_clr, "|", clr_off)
            # prune expired data
            prune_expired_packages("client")
            prune_expired_packages("server")
            prune_expired_jobs("client")
            prune_expired_jobs("server")
            prune_dead_pids("client")
            prune_dead_pids("server")
            # redraw the frame with dynamic width every cycle
            draw_tui_top_line()
            if (mode == "client") {
                draw_tui_body("client")
            } else if (mode == "server") {
                draw_tui_body("server")
            } else if (mode == "both") {
                draw_tui_body("server")
                draw_tui_body("client")
            } else {
                # invalid_mode
                diagnostic_messages["invalid_mode"][systime()] = "Invalid mode in choosing drawmode for draw_tui_body [" $0 "]"
            }
            if (verbosity > 5 || DEBUG == "True") { draw_tui_diagnostics(drawmode) }
            draw_tui_cmd_panel()
        } else if ($0 ~ /^distcc\[/) {
            # note: data from both log files is always parsed, only output screen drawing is mode-gated
            parse_client_line()
        } else if ($0 ~ /^distccd\[/) {
            # note: data from both log files is always parsed, only output screen drawing is mode-gated
            parse_server_line()
        } else {
                diagnostic_messages["unexpected_data"][systime()] = "Ingested unexpected or malformed data [" $0 "]"
        }
        # force output to terminal immediately
        fflush()
    }   # main block
        # the output of awk text processing is piped into a signal handler in real time
    ' | consume_tui_output          # this \' char is the end of awk itself
echo "$(timestamp) (DEBUG) consume_tui_output has exited, and run_tui_engine is about to" >>/tmp/tui_stream_exit_$$
}   # end run_tui_engine bash function

