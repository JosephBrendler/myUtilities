#-----[ traps ]------------------------------------------------------------------------------
# trap and ignore these signals
#   SIGTTOU - kernel sends this when a background process (or one whose terminal lost focus/suspended) - it suspends the process
#   SIGTTIN - kernel sends this when a background/detached process attempts to read from the controlling terminal
#   SIGPIPE - kernel sends this when a grep input or awk consumer pipeline exits prematurely
# (Do not trap SIGINT or SIGTERM here, - WANT clrl-c to be able to terminate the process so trap with cleanup
trap '' SIGTTOU SIGTTIN SIGPIPE

_cleanup_tui() {
    # if the controller is still running, kill it cleanly
    [ -n "$tui_controller_pid" ] && kill "$tui_controller_pid" 2>/dev/null
    wait "$tui_controller_pid" 2>/dev/null || true
    # if the fifo reader is still running, kill it cleanly (no separate reader now; it is in stream_log_data while loop)
#    [ -n "$ctrl_reader_pid" ] && kill "$ctrl_reader_pid" 2>/dev/null
#    wait "$ctrl_reader_pid" 2>/dev/null || true

    # if the tails are still running, kill them cleanly
    [ -n "$tui_client_tail_pid" ] && kill "$tui_client_tail_pid" 2>/dev/null
    wait "$tui_client_tail_pid" 2>/dev/null || true
    [ -n "$tui_server_tail_pid" ] && kill "$tui_server_tail_pid" 2>/dev/null
    wait "$tui_server_tail_pid" 2>/dev/null || true

    # restore terminal
    stty "$OLD_STTY" 2>/dev/null

    # cleanup files
    rm -f "$CTRL_FIFO" "/tmp/distcc_tui_controller_pid_${MAIN_PID}"
}
OLD_STTY=$(stty -g)
trap '_cleanup_tui; stty "$OLD_STTY" 2>/dev/null' EXIT INT TERM

