good_connectivity() {
    local ip_addr="$1"
    # first check connectivity, and then if possible use ssh to get hostname from server and tell it to register with dns
    # -c count; -W wait; -n nodns; note gnu timeout assurance
#    if timeout 1.5 ping -c 1 -W 1.5 -n "$ip_addr" &>/dev/null ; then
    # switch to devtcp to use port 22
    if timeout 1.5 bash -c "</dev/tcp/${ip_addr}/22" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

maybe_get_and_register_hostname() {
    # take over the screen to do this
    CLR; CUP 1 1
    j_msg -$notice -p "getent failed looking up ip_address [$ip_address], but it pings; trying ssh"
    # if ssh_agent isnt started start it and load keys (should only need to happen once)
    if [ -z "$AGENT_ENV" ] ; then
        j_msg -$notice -p "AGENT_ENV not set up; doing so now"
        j_msg -$notice -p -n "starting ssh agent ..."
        start_ssh_agent "$local_user" "$SSH_KEY"
        handle_result $? '' 'failed to start_ssh_agent' $notice || exit 1
        j_msg -$notice -p -n "loading local_user ssh key"
        load_key "$local_user"
        handle_result $? '' 'failed to load_key' $notice || exit 1
        sleep 3
        CLR; CUP 1 1
    fi
#    d_do 'echo "AGENT_ENV_FILE:"; cat $AGENT_ENV_FILE; echo "==========================="' $debug
    j_msg -$notice -p -n "sourcing AGENT_ENV_FILE [$AGENT_ENV_FILE]"
    source $AGENT_ENV_FILE  # source ssh_agent stuff incl auth sock
    handle_result $? '' 'failed to source AGENT_ENV_FILE' $notice || echo "maybe exit here"
    # set up a specific-identity, batchmode, timeout-sensitive ssh command to use in all four cases
    local -a ssh_cmd=( ssh -q -o ConnectTimeout=2 -o BatchMode=yes -i "$SSH_KEY" "${remote_user}@${ip_address}" )
    # use ssh to ask the remote ip_address to tell its hostname
    j_msg -$notice -p -n "looking up hostname"
    host_name=$(sudo -E -u "${local_user}" "${ssh_cmd[@]}" hostname)
    handle_result $? "$host_name" 'failed to look up host_name' $notice
    # if that did not work, then mark it unknown
    if [ -z "$host_name" ] ; then
        j_msg -$debug -p "failed to get hostname from ip_address, despite good ping"
        return 1
    else
        # get interface and ask remote machine to submit unregistered hostname to dns
        # Note: using -- /usr/sbin/ddns-update "$EVENT" "$ADDR" "$INTERFACE" "$SOURCE"
        j_msg -$notice -p -n "looking up interface"
        ssh_payload_command="ip -o addr show | grep '$ip_address'"
        iface=$(sudo -E -u "$local_user" "${ssh_cmd[@]}" "$ssh_payload_command" | awk '{print $2}')
        result=$?
        handle_result $result "$iface" '' $notice || return 1
        if [ -z "$iface" ] ; then
            j_msg -$debug -p "Note: host [$host_name] ip address [$ip_address] [unknown interface] is not registered with dns"
            sleep 3
            return 1
        else
#echo "in NOT -z (i.e. else) branch of if -z iface block"
            j_msg "-${notice}" -p "Note: host [$host_name] ip address [$ip_address] is not registered with dns"
            j_msg -$notice -p -n "Asking host [$host_name] via ssh to do that now"
            # now via ssh have the remote machine submit the update
            ssh_payload_command="rm -f /run/ddns-daemon.cache.*"
            sudo -E -u "$local_user" "${ssh_cmd[@]}" "$ssh_payload_command"
            result=$?
#echo "just ran sudo ... ssh ... status: [$result]"
            ssh_payload_command="/usr/sbin/ddns-update 'add' '$ip_address' '$iface' '${PN}-${BUILD}'"
            sudo -E -u "$local_user" "${ssh_cmd[@]}" "$ssh_payload_command"
            result=$?
#echo "just ran sudo ... ssh ... status: [$result]"
            handle_result $result '' "Host [$host_name] failed to reginster [$ip_address], [$iface] with dn" $notice || return 1
            sleep 3
        fi
#echo "now completely past if -z iface block"
    fi
    return 0
}

run_tui_engine() {
    # first call stream_dns_hostfiles (once) if in server mode
    #    (not applicable to client mode because client knows it is "localhost" and
    #     tui already knows who is in /etc/distcc/hosts, but server gets requests
    #      from ip addresses and tui has to look them up to be useful)
    # and tell it to send output to a temp file that stream_log_data can
    # inject into pipeline after the launch_tui_controller is launched
    local _initial_dns_file="/tmp/distcc_initial_dns_$$"
    # 20260724 - removed mode = server conditionality so user can switch modes and still have dns data
#    [[ "$mode" == "server" ]] && stream_dns_hostfiles "$_initial_dns_file"
    stream_dns_hostfiles "$_initial_dns_file"

    # 20260724 - make this interactive by calling this function
    #   to background a process to read keystrokes and prepare controls
    # 20260725 - converted controller to backgrounded function vs subshell and using fifo vs file
    rm -f "$CTRL_FIFO"
    # mkfifo gives atomic reads/writes and avoids races where the controller
    #    writes and the main loop misses the file or deletes it concurrently
    mkfifo "$CTRL_FIFO"
    # save this so cleanup can restore it
    OLD_STTY=$(stty -g)

    launch_tui_controller

    # main engine: create a background loop, grouped with tail using ( ... & ... ) and pipe this through
    # grep_filter to select relevant lines with --line-buffered immediately rendering then to output,
    # which is then piped to awk script to handle with associative arrays all keyed on pid
    # (HA! - but note that parallelism farms out preprocessing and compile with different pids,
    #  so the pid that competes the job may not be the one that "started" it)
    # (use tail -F rathern than -f so it will auto renew when log is rotated)

    # caution: the entire awk script must be single-quoted, so it cannot have ANY single-quites INSIDE it
    # (including contractions so do not put any apostraphe in dont; or just say do not instead)

    # 20260716 - instead of -
    #  (...) | awk '{...}' | while read signals ... /// chage to -
    #  awk '{...}' <(...#1) <(...#2) | while read signals ...
    #  (so we can feed two entire processes #1 being short-duration, and #2 being "infinite")
    # 20260718 - going back to (...) | grep | awk '{...}' | consumer to eliminate the first
    #  process substitution and the NR == NFR { ... } action block inside awk designed to consume
    #  dns updates, in favor of a single dns_cachu update block that can be called before and after
    #  the infinte hearbeat loop starts
    # 20260724 - pre-read dns data to a tempfile above
    #  and then tell stream_log_data to inject the same file here, thus separating
    #  network task requiring ssh keys and passphrase from the pipeline entirely
    (
        stream_log_data  "$_initial_dns_file" ;
         echo "$(timestamp) (DEBUG) stream_log_data has exited" >>/tmp/tui_stream_exit_$$
    ) | awk "${awk_vars[@]}" '
    #-----[ awk functions ]---------------------------------------------------------------
    # Debug: dump every incoming line to stderr to verify the pipe is alive
#    { print "DEBUG [awk input]: " $0 > "/dev/stderr"; fflush("/dev/stderr") }
    # use this function to shift historical items down and append anew entry
    function rotate_history(drawmode, new_record) {
        # shift existing records down by one index, and
        # insert the new record at the head of the array
        if (drawmode == "client") {
            for (i = history_depth; i > 1; i--) {
                c_history[i] = c_history[i-1]
            }
            c_history[1] = new_record
        } else if (drawmode == "server") {
            for (i = history_depth; i > 1; i--) {
                s_history[i] = s_history[i-1]
            }
            s_history[1] = new_record
        }
    }
    # use this function to clean up record of pid when it is done
    function delete_active_records(drawmode, p) {
        if (drawmode == "client") {
            delete c_active_peers[p]
            delete c_active_starts[p]
            delete c_active_input_files[p]
            delete c_active_output_files[p]
            delete c_active_outcomes[p]
            delete c_active_duration[p]
            delete c_last_contact[p]
        } else if (drawmode == "server") {
#            delete s_active_peers[p]      # (NO) pid persists with more jobs for this peer
            delete s_active_starts[p]
            delete s_active_input_files[p]
            delete s_active_output_files[p]
            delete s_active_outcomes[p]
            delete s_active_duration[p]
#            delete s_active_ip_addrs[p]   # (NO) pid persists with more jobs for this ip
            delete s_last_contact[p]
        } else {
            # invalid mode - just generate diagnostic
            diagnostic_messages["invalid_mode"][systime()] = "Invalid mode case in delete_active_records"
        }
    }
    # use this function to prune dead pids
    function prune_dead_pids(drawmode,    pid, parts, ts, reason) {
        if (drawmode == "client") {
            # consider aged-out and prune active records older than job_timeout
            for (pid in c_dead_pids) {
                # examine the reason the pid died, to determine wheter to do diagnostic message
                # format: dead_pid[pid] = systyme() "|" reason
                split(c_dead_pids[pid], parts, "|")
                ts = parts[1] + 0  # force awk to understand ts is a number
                reason = parts[2]
                # compare elapsed time against globally passed job_timeout
                if ((systime() - ts) > dead_pid_timeout) {
                    # prune the dead pid
                    delete c_dead_pids[pid]
                    if (reason != "exit") {
                        # log to diagnostics
                        diagnostic_messages["dead_pid_pruned"][systime()] = \
                            "Pruned dead client pid " pid " (reason: " reason ", timeout: " dead_pid_timeout "s)"
                    }
                }
            }
        } else if (drawmode == "server") {
            # consider aged-out and prune active records older than job_timeout
            for (pid in s_dead_pids) {
                # examine the reason the pid died, to determine wheter to do diagnostic message
                # format: dead_pid[pid] = systyme() "|" reason
                split(s_dead_pids[pid], parts, "|")
                ts = parts[1] + 0  # force awk to understand ts is a number
                reason = parts[2]
                # compare elapsed time against globally passed job_timeout
                if ((systime() - ts) > dead_pid_timeout) {
                    # prune the dead pid
                    delete s_dead_pids[pid]
                    if (reason != "exit") {
                        # log to diagnostics
                        diagnostic_messages["dead_pid_pruned"][systime()] = \
                            "Pruned dead server pid " pid " (reason: " reason ", timeout: " dead_pid_timeout "s)"
                    }
                }
            }
        } else {
            # invalid mode - just generate diagnostic
            diagnostic_messages["invalid_mode"][systime()] = "Invalid mode [" drawmode "] in prune_dead_pids"
        }
    }
    # use this function to prune expired jobs
    function prune_expired_jobs(drawmode,    pid) {
        if (drawmode == "client") {
            # consider aged-out and prune active records older than job_timeout
            for (pid in c_last_contact) {
                # compare elapsed time against globally passed job_timeout
                if ((systime() - c_last_contact[pid]) > job_timeout) {
                    # declare this pid dead for the anomalous reason "stale"
                    c_dead_pids[pid] = systime() "|stale"
                    # use existing cleanup function
                    delete_active_records(drawmode, pid)
                    # log to diagnostics
                    diagnostic_messages["expired_job_pruned"][systime()] = "Pruned expired client job " pid " (timeout: " job_timeout "s)"
                }
            }
        } else if (drawmode == "server") {
            # consider aged-out and prune active records older than job_timeout
            for (pid in s_last_contact) {
                # compare elapsed time against globally passed job_timeout
                if ((systime() - s_last_contact[pid]) > job_timeout) {
                    # declare this pid dead for the anomalous reason "stale"
                    s_dead_pids[pid] = systime() "|stale"
                    # use existing cleanup function
                    delete_active_records(drawmode, pid)
                    # log to diagnostics
                    diagnostic_messages["expired_job_pruned"][systime()] = "Pruned expired server job " pid " (timeout: " job_timeout "s)"
                }
            }
        } else {
            # invalid mode - just generate diagnostic
            diagnostic_messages["invalid_mode"][systime()] = "Invalid mode [" drawmode "] in prune_expired_jobs"
        }
    }
    # use this function to prune expired packages
    function prune_expired_packages(drawmode,    now, client_id, pkg) {
        now = systime()
        # consider aged-out and prune active packages older than pkg_timeout
        if (drawmode == "client" || drawmode == "both") {
            client_id = "localhost"
            for (pkg in c_active_packages[client_id]) {
                if (now - c_active_packages[client_id][pkg] > pkg_timeout) {
                    delete c_active_packages[client_id][pkg]
                }
            }
        } else if (drawmode == "server" || drawmode == "both") {
            for (client_id in s_active_packages) {
                for (pkg in s_active_packages[client_id]) {
                    if (now - s_active_packages[client_id][pkg] > pkg_timeout) {
                        delete s_active_packages[client_id][pkg]
                    }
                }
                # cleanup empty records
                if (length(s_active_packages[client_id]) == 0) {
                    delete s_active_packages[client_id]
                }
            }
        } else {
            diagnostic_messages["invalid_mode"][systime()] = "Invalid mode [" drawmode "] in prune_expired_packages"
        }
    }
    # use this function to generate ui assets needed by the script
    function repeat(marker, reps,    i, out_str) {
