        c_inputs_cnt = 0;   for (k in c_active_input_files) c_inputs_cnt++
        c_outputs_cnt = 0;  for (k in c_active_output_files) c_outputs_cnt++
        c_outcomes_cnt = 0; for (k in c_active_outcomes) c_outcomes_cnt++
        c_dur_cnt = 0;      for (k in c_active_duration) c_dur_cnt++
        c_pkg_cnt = 0;      for (k in c_active_packages) c_pkg_cnt++
        c_last_cnt = 0;     for (k in c_last_contact) c_last_cnt++
        c_dead_cnt = 0;     for (k in c_dead_pids) c_dead_cnt++

        s_hosts_cnt = 0;    for (k in s_active_peers) s_hosts_cnt++
        s_starts_cnt = 0;   for (k in s_active_starts) s_starts_cnt++
        s_inputs_cnt = 0;   for (k in s_active_input_files) s_inputs_cnt++
        s_outputs_cnt = 0;  for (k in s_active_output_files) s_outputs_cnt++
        s_outcomes_cnt = 0; for (k in s_active_outcomes) s_outcomes_cnt++
        s_dur_cnt = 0;      for (k in s_active_duration) s_dur_cnt++
        s_pkg_cnt = 0;      for (k in s_active_packages) s_pkg_cnt++
        s_last_cnt = 0;     for (k in s_last_contact) s_last_cnt++
        s_dead_cnt = 0;     for (k in s_dead_pids) s_dead_cnt++

        ip_cnt = 0;         for (k in s_active_ip_addrs) ip_cnt++
        cache_cnt = 0;    for (k in dns_cache) cache_cnt++

        if (mode == "client" || mode == "both") {
            printf "    c_hosts: %d", c_hosts_cnt
            printf " | c_starts: %d", c_starts_cnt
            printf " | c_infiles: %d", c_inputs_cnt
            printf " | c_outfiles: %d\n", c_outputs_cnt
            printf "    c_outcomes: %d", c_outcomes_cnt
            printf " | c_durs: %d", c_dur_cnt
            printf " | c_pkgs: %d", c_pkg_cnt
            printf " | c_contacts: %d", c_last_cnt
            printf " | c_deads: %d\n", c_dead_cnt
        } else if (mode == "server" || mode == "both") {
            printf "    s_hosts: %d", s_hosts_cnt
            printf " | s_starts: %d", s_starts_cnt
            printf " | s_infiles: %d", s_inputs_cnt
            printf " | s_outfiles: %d\n", s_outputs_cnt
            printf "    s_outcomes: %d", s_outcomes_cnt
            printf " | s_durs: %d", s_dur_cnt
            printf " | s_pkgs: %d", s_pkg_cnt
            printf " | s_contacts: %d", s_last_cnt
            printf " | s_deads: %d\n", s_dead_cnt
            printf "    ips: %d", ip_cnt
            printf " | cache: %d\n", cache_cnt
        }
        printf "    max_active_lines: %d", max_active_lines
        printf " | max_package_lines: %d", max_package_lines
        printf " | history_depth: %d\n", history_depth
        printf "    package_timeout: %d", package_timeout
        printf " | job_timeout: %d", job_timeout
        printf " | dead_pid_timeout: %d\n", dead_pid_timeout
        printf "    ssh_timeout: %d", ssh_timeout
        printf " | tui_refresh_period: %s", tui_refresh_period
        printf " | DISTCC_TUI_MAIN_PID: %s", DISTCC_TUI_MAIN_PID
        printf " | tui_controller_pid: %s\n", tui_controller_pid

        #-----[ verify dynamic shell data (width) ingested  ]-----------------------------
        printf "   Width: [%s] (drag frame to change)\n", width

        #-----[ show dns_cache record count ]--------------------------------------------
#        printf "  [ DIAGNOSTICS ] dns_cache keys (first 3):\n"
#        i = 0
#        for (k in dns_cache) {
##            if (k ~ /fd62:6262:6262:0/){
#                printf "    > [%s]\n", k
#            }
#           if (++i > 2) break   # zero-indexed (allows 3)
#        }
        #printf "last __HEARTBEAT__: [%s]\n", $0
        #-----[ show accumulated diagnostic errors ]--------------------------------------
        # 20260722 - changed from pseudo (POSIX) multi-demensional array diagnostic_messages[err_key]
        #   where err_key is stored internally by awk as "<err_type><FS><timestamp>" and
        #   FS = ascii File/Field separator, \034 - identified by SUBSEP
        #   thus effective format is diagnostic_messages[type, timestamp] = "message"
        # and changed TO (GAWK) multi-dimensional array diagnostic_messages[type][timestamp]
        # note: systime timestamps have one-second resolution so these are throttled at max 1/sec
        local_now = systime()
        has_errors = 0

        # first, pass - check for and purge expired errors
        diag_err_cnt=0
        # pass 1 - prune expired diagnostic messages
        for (type in diagnostic_messages) {
            for (ts in diagnostic_messages[type]) {
                if ((local_now - ts) > diagnostic_timeout) {
                    delete diagnostic_messages[type][ts]
                } else {
                    diag_err_cnt++
                }
            }
            # check if type sub-array is empty and delete if so, to prune empty outer category from diagnostic_messages,
            # and keep it from causing diag_err_cnt to remain above 0 indefinitely
            if (length(diagnostic_messages[type]) == 0) {
                delete diagnostic_messages[type]
            }
        }
        printf "  Active Diagnostic Message Count: [%s]\n", diag_err_cnt

        # pass 2 - if there are errors to display, print them
        if (diag_err_cnt > 0) {
            printf "%s\n", dubdashline
            printf "  %s[ Diagnostic Alert Messages ]%s\n", title_clr, clr_off

            # process types in specified variable order
            # note: diag_msg_type_order is defined by array at top of bash script
            #   and is converted to space delimited string for awk with -v
            n_types = split(diag_msg_type_order, ordered_types)
            for (i = 1; i <= n_types; i++) {
                type = ordered_types[i]
                if (type in diagnostic_messages) {
                    # iterate over active timestamps
                    for (ts in diagnostic_messages[type]) {
                        diag_time_left = diagnostic_timeout - (systime() - ts)
                        printf "  [%s%s%s] %s (%s%s%s)\n",
                            failure_clr, strftime("%H:%M:%S", ts), clr_off,
                            diagnostic_messages[type][ts],
                            ts_clr, diag_time_left, clr_off
                    }
                }
            }
        }
        printf "%s\n", dubdashline
    }   # end draw_tui_diagnostics
