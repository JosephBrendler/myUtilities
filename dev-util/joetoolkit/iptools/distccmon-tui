stream_log_data() {
    # accept _initial_dns_file as $1 so as to be able to inject it with cat below
    local _initial_dns_file="$1"
    # setup and messaging block goes to stderr so awk ignores it
    {
        j_msg -$notice -p "Starting log stream for: [$tui_client_DISTCC_LOG] and [$tui_server_DISTCC_LOG]"
        j_msg -$debug -p "grep_filter: [$grep_filter]"
        j_msg -$debug -p "tui_refresh_period: [$tui_refresh_period]"
        j_msg -$debug -p "mode: [$mode]"

    } >&2
    # data generation block must go to stdout so awk receives it
    {
        # inject pre-fetched dns data into awk stream and clean up temp file
        # 20260724 - removed mode = server conditionality so use can switch modes and still have dns data
        if [ -f "$_initial_dns_file" ]; then
            cat "$_initial_dns_file"
            rm -f "$_initial_dns_file"
        fi

        # if option -H|--history was set ($HISTORY) then read it all
        if [ $HISTORY ]; then
            j_msg -$notice -p "First ingesting all of recorded history, please wait a few seconds ..." >&2
            # first dump and roll up all of recorded history for both client and server logs - do not background this
            # ensure this massive dump is complete BEFORE backgrounding tail -F and interleaving the hearbeat
            for old_log in ${tui_client_DISTCC_OLDLOG_GLOB}; do [[ -f "$old_log" ]] && zcat "$old_log"; done
            for old_log in ${tui_server_DISTCC_OLDLOG_GLOB}; do [[ -f "$old_log" ]] && zcat "$old_log"; done
        fi
        # if option -H|--history was set ($HISTORY) then read all of the current log files, else the configured reachback
        if [ $HISTORY ]; then
            cat "$tui_client_DISTCC_LOG"
            cat "$tui_server_DISTCC_LOG"
        else
            tail -n $tui_reachback "$tui_client_DISTCC_LOG"
            tail -n $tui_reachback "$tui_server_DISTCC_LOG"
        fi
        # now background the continued steaming of any future lines in both log files (save pids to kill on quit)
        j_msg -$notice -p "Now backgrounding tail -F to stream all future client log lines" >&2
        tail -F "$tui_client_DISTCC_LOG" &  tui_client_tail_pid=$!
        j_msg -$notice -p "Now backgrounding tail -F to stream all future server log lines" >&2
        tail -F "$tui_server_DISTCC_LOG" &  tui_server_tail_pid=$!

        j_msg -$notice -p "Now starting infinite loop for hearbeat" >&2
        sleep 1
        # infinite loop, injecting hearbeat with dynamic formatting data (width)
        # (optionally also include "spoofed" log data to test error handling)
        # open fd 5 for read on CTRL_FIFO (fd3 is reading tty, fd4 is writing fifo)
        exec 5< "$CTRL_FIFO"
        while [ $TRUE ]; do
            # read --help | grep ' \-t' 2>/dev/null
            #   -t timeout  time out and return failure if a complete line of input is not read within TIMEOUT seconds
            if read -t 0.01 cmd <&5 2>/dev/null; then
                printf "__CONTROL__ %s\n" "$cmd"
                [ "$cmd" = "QUIT" ] && break
            fi
            # redirect stderr and break on error to catch quit/exit from awk without a stream of "broken pipe" messages
            # and ensure a deterministic way to exit the controller loop when the tty is no longer readable
            printf "__HEARTBEAT__ %d\n" "$(termwidth)" 2>/dev/null || break
            # for testing diagnostic logic only (match both "distcc[" AND "compile from"
#            printf "distcc[000000] compile from spoofed client record for testing \n"
            # for testing diagnostic logic only (match both "distcc[" AND "compile from"
#            printf "distccd[000000] compile from spoofed server record for testing\n"
            # for testing diagnostic logic only (match  "__DNS_UPDATE__")
#            printf "__DNS_UPDATE__    1.1.1.1    spoofed_test_host\n"
            sleep "$tui_refresh_period"
        done
        # kill the backgrounded tails here, or they get orphaned when subshell exits
        [ -n "$tui_client_tail_pid" ] && kill "$tui_client_tail_pid" 2>/dev/null
        [ -n "$tui_server_tail_pid" ] && kill "$tui_server_tail_pid" 2>/dev/null

        j_msg -$debug -p "$(timestamp) (DEBUG) infinite loop exited after done" >&2
        # now release fd5
        exec 5<&-
    } | grep --line-buffered --text -E "$grep_filter"
}

stream_dns_hostfiles() {
    local result=0 ssh_cmd=""
    local _dns_outfile="$1"

    # define a sed filter to transform raw lines of dns /etc/hosts.d/* files
    #   into the update input format expected by the awk's __DNS_UPDATE__ action block
    #   employ with LC_ALL=C sed "$SED_DNS_FILTER"
    # line format: 192.168.62.183  g3nuc01.brendler  # eth0  2026-06-12_07:40:38  ddns-update-hook-ipv4-0.3.1
    # strip blank lines and comments
    SED_DNS_FILTER="/^${W0}#/d; /^${W0}$/d; "
    # strip all right of including # and whitespace immediately preceding it (note: escape \#)
    SED_DNS_FILTER+="s/${W1}#${P1}$//; "
    # prepend "__DNS_UPDATE__" as awk action block expects
    SED_DNS_FILTER+="s/^/__DNS_UPDATE__ /; "
    # now sort the data on ip address
    SORT_DNS_FILTER+="sort -k2"

    # group setup commands and redirect stdout to stderr to protect the awk stream
    {
        start_ssh_agent "$local_user"
        source "$AGENT_ENV_FILE"
        load_key "$local_user"
        j_msg -$debug -p "local_user: $local_user"
        j_msg -$debug -p "dns: $dns"
        j_msg -$debug -p "SSH_KEY: $SSH_KEY"
        j_msg -$notice -p -n "Streaming dns hosts files directly to awk memory cache"
    } >&2

    # run the ssh command, outputting the raw file contents directly to stdout
    # note: -n prevents stdin hanging; BatchMode=yes prevents interactive prompts
    sudo_cmd=( sudo -u "$local_user" SSH_AUTH_SOCK="$SSH_AUTH_SOCK" )
    ssh_cmd=( ssh -n -q -i "$SSH_KEY" -o ConnectTimeout=2 -o BatchMode=yes "${remote_user}@${dns}" )
    payload_cmd=( cat '/etc/hosts.d/*' )
    sort_cmd=( sort -k2 )
    # now run the command, sending output to file or stdout as appropriate
    if [ -n "$_dns_outfile" ]; then
        "${sudo_cmd[@]}" "${ssh_cmd[@]}" "${payload_cmd[@]}" | sed "$SED_DNS_FILTER" | "${sort_cmd[@]}" > "$_dns_outfile"
    else
        "${sudo_cmd[@]}" "${ssh_cmd[@]}" "${payload_cmd[@]}" | sed "$SED_DNS_FILTER" | "${sort_cmd[@]}"
    fi
    result=$?
    # group teardown commands and redirect stdout to stderr
    {
        handle_result $result "" "" $notice
        unload_key "$local_user" && \
        stop_ssh_agent "$local_user"
        result=$?
        j_msg -$notice -p "Done streaming dns host files; exiting with status code [$result]"
    } >&2
}

launch_tui_controller() {
    # initialize namespaced local variables
    local _ctrl_key=""
    # controller runs as a backgrounded function (not a subshell)
    tui_controller() {
        # open /dev/tty on fd 3 for stable read input
        exec 3</dev/tty
        # open the CTRL_FIFO created at the top of the script on fd 4 for writing
        exec 4> "$CTRL_FIFO"
        # set stty to raw mode so single characters are caught instantly without pressing Enter
        # redirection of fd3 ensures stable read of actual tty device
        # (main script will restore OLD_STTY on exit)
        stty -icanon -echo <&3
        while [ $TRUE ]; do
            # read --help | grep -E ' \-r| \-n| \-s' 2>/dev/null
            #   -n nchars return after reading NCHARS characters rather than waiting
            #   -r do not allow backslashes to escape any characters
            #   -s do not echo input coming from a terminal
            # or break to ensure deterministic exit if read fails
            # use or true below incase set -e is adopted (canonical strict-mode pattern)
            IFS= read -r -n 1 -s _ctrl_key <&3 || break
            case "$_ctrl_key" in
                '+') printf "VERBOSITY_UP\n" >&4 ;;
                '-') printf "VERBOSITY_DOWN\n" >&4 ;;
            'D'|'V') printf "TOGGLE_DEBUG\n" >&4 ;;
                'c') printf "CLIENT_MODE\n" >&4 ;;
                's') printf "SERVER_MODE\n" >&4 ;;
                'b') printf "BOTH_MODE\n" >&4 ;;
                'q')
                    printf "QUIT\n" >&4
                    # explicitly signal the main script PID
                    if [ -n "$DISTCC_TUI_MAIN_PID" ]; then
                      kill -USR1 "$DISTCC_TUI_MAIN_PID" 2>/dev/null || true
                    else
                      kill -USR1 "$MAIN_PID" 2>/dev/null || true
                    fi
                    return 0
                    ;;
            esac
        done
        # best-effort controller-local cleanup and restore fds
        stty sane <&3 2>/dev/null || true
        exec 3<&-   # was /dev/tty read
        exec 4>&-   # was fifo write
    }   # end tui_controller function

    tui_controller &       # background the function
    tui_controller_pid=$!  # reliably storee tui_controller PID in parent shell
    echo "$tui_controller_pid" > "/tmp/distcc_tui_controller_pid_${MAIN_PID}"
}

validate_tui_input_logfile() {
    vti_ret=0
    local mode="$1"
    # ensure mode-dependet log file exists and has proper ownership and permissions
    local file="" perms="" ownership=""
    case "$mode" in
        client)
            file="/var/log/distcc/distcc-client.log"
            perms="644"
            ownership="portage:portage"
            ;;
        server)
            file="/var/log/distcc/distccd.log"
            perms="644"
            ownership="distcc:daemon"
            ;;
        *) return 1 ;;
    esac
    # find or create the input logfile
    j_msg -$notice -p -n "Looking for input logfile [$file]"
    [ -f "$file" ]
    handle_result $? "found" "not found" $notice
    if [ ! $? -eq 0 ]; then
        j_msg -$notice -p -n "Creating input logfile [$file]"
        touch "$file"
        handle_result $? "created" "" $notice || vti_ret=1
    fi
    # set permissions on input logfile
    j_msg -$notice -p -n "Setting permissions on input logfile [$file]"
    chmod "$perms" "$file"
    handle_result $? "$(stat -c %a "$file")" "" $notice || vti_ret=$(( vti_ret | 2 ))
    # set ownership on input logfile
    j_msg -$notice -p -n "Setting ownership of input logfile [$file]"
    chown "$ownership" "$file"
    handle_result $? "$(stat -c %U:%G  "$file")" "" $notice || vti_ret=$(( vti_ret | 4 ))
    return $vti_ret
}

